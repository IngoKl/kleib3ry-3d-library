{
  "name": "library3d",
  "version": "0.1.0",
  "description": "A 3D personal library: read your own PDFs and EPUBs in a room you design.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "scan": "cargo run --release --manifest-path src-tauri/Cargo.toml --bin scan --",
    "verify": "npm run typecheck && npm run build && npm run test && npm run test:rust",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icon": "node scripts/make-icon.mjs && tauri icon assets/icon-source.png",
    "test:desktop": "node scripts/probe-desktop.mjs",
    "assets": "node scripts/copy-pdfjs-assets.mjs && node scripts/make-sample-book.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
